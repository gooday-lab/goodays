---
import Base from '../layouts/Base.astro';
import { getContent, localized } from '../lib/content';
import { PICKS, AFFILIATE } from '../lib/picks';

const { categories, products, articles } = await getContent();
const featured = products.filter((p) => p.is_featured).slice(0, 6);
const shownProducts = featured.length ? featured : products.slice(0, 6);

const stars = (rating: number | null) => {
  const value = Math.max(0, Math.min(5, Number(rating) || 0));
  const full = Math.floor(value);
  const half = value - full >= 0.5;
  return `<span class="rating-stars" aria-label="${value} out of 5 stars">${
    Array.from({ length: 5 }, (_, i) =>
      `<span class="rating-star ${i < full ? 'is-full' : i === full && half ? 'is-half' : 'is-empty'}" aria-hidden="true">★</span>`).join('')
  }</span>`;
};

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'WebSite', name: 'GoOdays',
    url: 'https://goodays.pages.dev/', inLanguage: ['id', 'en'],
    description: 'Rekomendasi produk terbaik per kategori dengan review jujur — dikurasi oleh GoOdays.',
    potentialAction: { '@type': 'SearchAction', target: 'https://goodays.pages.dev/reviews/?q={search_term_string}', 'query-input': 'required name=search_term_string' }
  },
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: 'GoOdays',
    url: 'https://goodays.pages.dev/', logo: 'https://goodays.pages.dev/assets/logo.png',
    email: 'thomasoddyc@gmail.com',
    sameAs: ['https://instagram.com/oddychris', 'https://www.tiktok.com/@thomasoddy']
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: 'Pilihan Terbaik Bulan Ini — GoOdays',
    itemListElement: PICKS.map((pick, index) => ({
      '@type': 'ListItem', position: index + 1, name: pick.name,
      url: pick.shopeeUrl || 'https://goodays.pages.dev/reviews/'
    }))
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: [
      ['Apakah GoOdays mendapat komisi dari link di situs ini?', 'Ya. Beberapa link adalah link afiliasi Shopee — jika kamu membeli lewat link tersebut, GoOdays mendapat komisi kecil tanpa biaya tambahan untukmu. Harga tetap sama. Komisi ini yang membiayai riset dan penulisan review.'],
      ['Bagaimana cara GoOdays memilih produk?', 'Tiga langkah: riset ulasan pembeli nyata, perbandingan dengan pesaing sekelas, lalu kurasi akhir. Kami hanya merekomendasikan produk yang benar-benar akan kami beli sendiri atau berikan ke keluarga.'],
      ['Apakah review-nya jujur?', 'Setiap review mencantumkan kelebihan DAN kekurangan. Jika sebuah produk punya kelemahan, kami tulis apa adanya. Rekomendasi tidak bisa dibeli.'],
      ['Apakah harga di sini selalu terbaru?', 'Harga dan stok di marketplace berubah kapan saja, jadi setiap review mencantumkan tanggal update terakhir. Selalu cek harga terkini di Shopee sebelum membeli.']
    ].map(([question, answer]) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } }))
  }
];
---
<Base
  title="GoOdays — Rekomendasi Produk Terbaik, Review Jujur & Temuan Pilihan"
  description="GoOdays membantu kamu membeli lebih baik, bukan lebih banyak. Rekomendasi produk terbaik per kategori, review jujur dengan kelebihan & kekurangan, dan panduan belanja yang sudah dikurasi."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <main>
    <!-- HERO -->
    <section id="home" class="hero section-pad">
      <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="eyebrow-dot"></span> <span data-i18n="eyebrow">REKOMENDASI PRODUK TERBAIK</span></p>
          <h1 data-i18n="heroTitle">Beli lebih baik,<br><em>bukan</em> lebih banyak.</h1>
          <p class="hero-lede" data-i18n="heroText">Review jujur, perbandingan jelas, dan rekomendasi yang benar-benar layak beli. Kami sudah riset ratusan ulasan pembeli — kamu tinggal pilih dengan percaya diri.</p>
          <div class="hero-buttons">
            <a href="#picks" class="button button-orange" data-i18n="heroCta">Lihat 3 Rekomendasi Terbaik <span>↓</span></a>
            <a href="/reviews/" class="text-link" data-i18n="heroCtaSub">Jelajahi semua review <span>→</span></a>
          </div>
          <ul class="hero-proof">
            <li data-i18n="proof1">✓ Review jujur — kelebihan &amp; kekurangan</li>
            <li data-i18n="proof2">✓ Harga dicek &amp; diupdate berkala</li>
            <li data-i18n="proof3">✓ Tanpa spam, tanpa drama</li>
          </ul>
        </div>
        <div class="hero-art" aria-label="Featured products">
          <div class="hero-art-bg"></div>
          <div class="floating-note note-top"><span>✦</span><strong data-i18n="noteTop">Pilihan editor</strong><small>GoOdays / 01</small></div>
          <div class="product-orb"><div class="orb-shine"></div><span class="orb-label">G</span></div>
          <div class="hero-card hero-card-main"><div class="card-image image-coffee"></div><div class="hero-card-meta"><span data-i18n="coffeePick">Pilihan kopi</span><strong data-i18n="coffeePickLine">Ritual pagi, naik level.</strong><span class="mini-arrow">↗</span></div></div>
          <div class="hero-card hero-card-small"><div class="small-stars">★★★★★</div><strong data-i18n="lovedBy">Dipilih untuk kamu</strong><small data-i18n="lovedBySub">Dari ratusan ulasan pembeli</small></div>
          <div class="scribble">good<br>things<br>inside <span>↘</span></div>
        </div>
      </div>
    </section>

    <!-- TRUST BAR -->
    <section class="trustbar" aria-label="Mengapa percaya GoOdays">
      <div class="container trustbar-grid">
        <div class="trust-item"><strong>6</strong><span data-i18n="trustStat1">kategori dikurasi</span></div>
        <div class="trust-item"><strong data-i18n="trustStat2Value">100+</strong><span data-i18n="trustStat2">ulasan pembeli diriset per produk</span></div>
        <div class="trust-item"><strong data-i18n="trustStat3Value">3</strong><span data-i18n="trustStat3">langkah kurasi sebelum masuk daftar</span></div>
        <div class="trust-item"><strong data-i18n="trustStat4Value">0</strong><span data-i18n="trustStat4">biaya tambahan untukmu — komisi dari Shopee</span></div>
      </div>
    </section>

    <!-- TOP PICKS -->
    <section id="picks" class="section-pad picks-section">
      <div class="container">
        <div class="section-heading heading-inline">
          <div>
            <p class="eyebrow">01 / <span data-i18n="picksEyebrow">PILIHAN TERBAIK BULAN INI</span></p>
            <h2 data-i18n="picksTitle">Tiga yang benar-benar<br><em>layak beli.</em></h2>
          </div>
          <div class="section-heading-actions">
            <p class="section-intro" data-i18n="picksIntro">Tidak mau baca panjang? Ini tiga rekomendasi utama kami — best overall, best budget, dan best premium.</p>
          </div>
        </div>
        <div class="pick-grid" id="bestPicks">
          {PICKS.map((pick, index) => {
            const url = AFFILIATE.buildUrl(pick.shopeeUrl, `picks-${pick.id}`);
            return (
              <article class={`pick-card ${index === 0 ? 'is-featured' : ''}`}>
                <span class="pick-badge">{pick.badge.id}</span>
                <span class="pick-rank">0{index + 1}</span>
                <h3 class="pick-name">{pick.name}</h3>
                <div class="pick-meta" set:html={stars(pick.rating)} />
                <div class="pick-meta"><span>{pick.rating ? `${pick.rating} / 5` : '—'}</span><span class="pick-price">{pick.price}</span></div>
                <p class="pick-verdict">{pick.verdict.id}</p>
                <p class="pick-pros-label">Kenapa layak</p>
                <ul class="pick-pros">{pick.pros.id.map((item) => <li>{item}</li>)}</ul>
                <div class="pick-cta-row">
                  <a class="button button-shopee" data-aff={`pick-${pick.id}`} data-product={pick.name}
                     href={url || '#'} target={url ? '_blank' : undefined} rel={url ? 'nofollow sponsored noopener' : undefined}>
                     Cek harga di Shopee <span>↗</span>
                  </a>
                  <a class="text-link pick-review-link" href={pick.reviewUrl}>Baca review lengkap <span>→</span></a>
                </div>
              </article>
            );
          })}
        </div>
        <p class="picks-note" data-i18n="picksNote">Harga &amp; stok bisa berubah kapan saja. Setiap pembelian lewat link di atas membantu GoOdays tetap berjalan — tanpa biaya tambahan untukmu.</p>
      </div>
    </section>

    <!-- CATEGORIES -->
    <section id="categories" class="section-pad categories-section">
      <div class="container">
        <div class="section-heading heading-inline">
          <div>
            <p class="eyebrow">02 / <span data-i18n="sectionCategories">KATEGORI</span></p>
            <h2 data-i18n="categoryTitle">Sesuatu yang kecil<br><em>untuk semua.</em></h2>
          </div>
          <a href="/reviews/" class="text-link" data-i18n="allReviews">Semua review <span>→</span></a>
        </div>
        <div class="category-grid">
          {categories.length === 0 && <div class="home-reviews-empty">Kategori akan tampil setelah tersedia dari dashboard.</div>}
          {categories.map((category) => (
            <a class="category-card" href={`/reviews/?category=${category.slug}`}>
              <span class="category-icon">{category.emoji || '✦'}</span>
              <div>
                <h3>{localized(category, 'name')}</h3>
                <p>{localized(category, 'description')}</p>
              </div>
              <span class="card-arrow">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- HOW WE PICK -->
    <section class="section-pad how-section">
      <div class="container">
        <div class="section-heading heading-inline">
          <div>
            <p class="eyebrow">03 / <span data-i18n="howEyebrow">CARA KAMI MEMILIH</span></p>
            <h2 data-i18n="howTitle">Bukan asal<br><em>rekomendasi.</em></h2>
          </div>
          <p class="section-intro" data-i18n="howIntro">Setiap produk melewati tiga langkah ini sebelum masuk daftar kami.</p>
        </div>
        <div class="how-grid">
          <div class="how-step reveal"><span class="how-num">01</span><h3 data-i18n="howStep1">Riset dari yang sudah beli</h3><p data-i18n="howStep1Text">Kami membaca puluhan hingga ratusan ulasan pembeli nyata — bukan cuma spesifikasi di kemasan.</p></div>
          <div class="how-step reveal"><span class="how-num">02</span><h3 data-i18n="howStep2">Bandingkan dengan pesaingnya</h3><p data-i18n="howStep2Text">Produk yang masuk daftar harus menang di harga, kualitas, atau keduanya dibanding alternatif sekelas.</p></div>
          <div class="how-step reveal"><span class="how-num">03</span><h3 data-i18n="howStep3">Kurasi akhir yang jujur</h3><p data-i18n="howStep3Text">Kalau ada kekurangan, kami tulis. Kalau tidak layak, tidak masuk daftar. Sesederhana itu.</p></div>
        </div>
      </div>
    </section>

    <!-- JOURNAL -->
    <section id="articles" class="section-pad editorial-section">
      <div class="container">
        <div class="section-heading heading-inline"><div><p class="eyebrow">04 / <span data-i18n="sectionArticles">JURNAL</span></p><h2 data-i18n="articleTitle">Cara yang lebih cerdas<br><em>untuk menemukan.</em></h2></div><a href="/#articles" class="text-link" data-i18n="allArticles">Semua artikel <span>→</span></a></div>
        <div class="article-grid">
          {articles.length === 0 && <div class="home-reviews-empty">Artikel pilihan akan tampil di sini setelah dipublikasikan dari dashboard.</div>}
          {articles.slice(0, 3).map((article, index) => (
            <article class={`article-card ${index === 0 ? 'article-large' : ''}`}>
              <div class="article-image image-home">
                {article.cover_image_url && <img src={article.cover_image_url} alt={localized(article, 'title')} loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;" />}
                <span class="article-tag">{article.category?.name_en || 'ARTICLE'}</span>
              </div>
              <div class="article-content">
                <p class="article-kicker">{index === 0 ? 'ARTIKEL PILIHAN' : 'ARTIKEL BARU'}</p>
                <h3>{localized(article, 'title')}</h3>
                <p>{localized(article, 'excerpt')}</p>
                <a href={`/articles/${article.slug}/`} class="text-link">Baca artikel <span>↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- REVIEWS -->
    <section id="reviews" class="section-pad reviews-section">
      <div class="container">
        <div class="section-heading heading-inline"><div><p class="eyebrow">05 / <span data-i18n="sectionReviews">PRODUCT REVIEWS</span></p><h2 data-i18n="reviewTitle">Dicoba, diuji,<br><em>layak dibagikan.</em></h2></div><div class="section-heading-actions"><p class="section-intro" data-i18n="reviewIntro">Kelebihan yang jelas, kekurangan yang jujur, dan detail yang membantumu memilih dengan percaya diri.</p><a href="/reviews/" class="text-link" data-i18n="allReviews">Semua review <span>→</span></a></div></div>
        <div class="review-grid">
          {shownProducts.length === 0 && <div class="home-reviews-empty">Produk pilihan akan tampil di sini setelah dipilih dari dashboard.</div>}
          {shownProducts.map((product) => (
            <article class="review-card">
              <div class="review-visual visual-headphones">
                {localized(product, 'badge') && <span class="pill">{localized(product, 'badge')}</span>}
                {product.image_url
                  ? <img src={product.image_url} alt={product.name} loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;" />
                  : <div style="font-size:72px;color:var(--green);">✦</div>}
              </div>
              <div class="review-body">
                <div class="stars" set:html={stars(Number(product.rating))} />
                <h3>{product.name}</h3>
                <p class="muted">{localized(product, 'summary')}</p>
                <a href={`/reviews/${product.slug || product.id}/`} class="button button-dark review-link">Lihat review <span>↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-pad faq-section">
      <div class="container faq-grid">
        <div>
          <p class="eyebrow">06 / <span data-i18n="faqEyebrow">PERTANYAAN UMUM</span></p>
          <h2 data-i18n="faqTitle">Jujur saja,<br><em>bagaimana ini bekerja?</em></h2>
          <p class="faq-lead" data-i18n="faqLead">Transparansi itu bagian dari produknya. Ini jawaban untuk yang paling sering ditanyakan.</p>
        </div>
        <div class="faq-list">
          <details class="faq-item" open>
            <summary data-i18n="faqQ1">Apakah GoOdays mendapat komisi dari link di situs ini?</summary>
            <p data-i18n="faqA1">Ya. Beberapa link adalah link afiliasi Shopee — jika kamu membeli lewat link tersebut, GoOdays mendapat komisi kecil tanpa biaya tambahan untukmu. Harga tetap sama. Komisi ini yang membiayai riset dan penulisan review.</p>
          </details>
          <details class="faq-item">
            <summary data-i18n="faqQ2">Bagaimana cara GoOdays memilih produk?</summary>
            <p data-i18n="faqA2">Tiga langkah: riset ulasan pembeli nyata, perbandingan dengan pesaing sekelas, lalu kurasi akhir. Kami hanya merekomendasikan produk yang benar-benar akan kami beli sendiri atau berikan ke keluarga.</p>
          </details>
          <details class="faq-item">
            <summary data-i18n="faqQ3">Apakah review-nya jujur?</summary>
            <p data-i18n="faqA3">Setiap review mencantumkan kelebihan DAN kekurangan. Jika sebuah produk punya kelemahan, kami tulis apa adanya. Rekomendasi tidak bisa dibeli.</p>
          </details>
          <details class="faq-item">
            <summary data-i18n="faqQ4">Apakah harga di sini selalu terbaru?</summary>
            <p data-i18n="faqA4">Harga dan stok di marketplace berubah kapan saja, jadi setiap review mencantumkan tanggal update terakhir. Selalu cek harga terkini di Shopee sebelum membeli.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- NEWSLETTER -->
    <section class="newsletter section-pad">
      <div class="container newsletter-inner">
        <div>
          <p class="eyebrow light">THE GOOD LIST</p>
          <h2 data-i18n="newsletterTitle">Temuan bagus,<br><em>dikirimkan.</em></h2>
          <p data-i18n="newsletterText">Rekomendasi baru, harga yang lagi bagus, dan tips belanja bijak. Dikirim sesekali — tanpa noise.</p>
          <a class="lead-link" href="/checklist-beli-bijak/" data-i18n="leadMagnet">🎁 Gratis: Checklist Beli Bijak (10 poin) <span>→</span></a>
        </div>
        <form id="newsletterForm" class="newsletter-form">
          <label class="sr-only" for="email">Email</label>
          <input id="email" type="email" required placeholder="email@kamu.com" data-i18n-placeholder="emailPlaceholder">
          <button type="submit" class="button button-cream" data-i18n="subscribe">Berlangganan <span>→</span></button>
          <small data-i18n="noSpam">Tanpa spam. Hanya hal-hal bagus. Unsubscribe kapan saja.</small>
        </form>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="section-pad about-section">
      <div class="container about-grid">
        <div>
          <p class="eyebrow">07 / <span data-i18n="sectionAbout">TENTANG GOODAYS</span></p>
          <h2 data-i18n="aboutTitle">Lebih sedikit noise.<br><em>Lebih banyak good.</em></h2>
        </div>
        <div class="about-copy">
          <p class="big-copy" data-i18n="aboutLead">GoOdays adalah sudut internet untuk orang-orang yang ingin membeli lebih baik, bukan lebih banyak.</p>
          <p data-i18n="aboutText">Kami mencari produk yang punya alasan untuk ada, membaca detailnya, dan membagikan apa yang benar-benar akan kami rekomendasikan ke teman. Karena temuan terbaik adalah yang tetap berguna jauh setelah unboxing.</p>
          <a href="/#contact" class="text-link" data-i18n="sayHello">Sapa kami <span>↗</span></a>
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="contact-section">
      <div class="container contact-grid">
        <div>
          <p class="eyebrow light">08 / <span data-i18n="sectionContact">KONTAK</span></p>
          <h2 data-i18n="contactTitle">Punya ide<br><em>bagus?</em></h2>
          <p data-i18n="contactText">Pertanyaan, kerja sama, atau ingin berbagi temuan keren? Kami ingin mendengarnya.</p>
          <a class="contact-email" href="mailto:thomasoddyc@gmail.com">thomasoddyc@gmail.com <span>↗</span></a>
        </div>
        <form id="contactForm" class="contact-form">
          <div class="form-row">
            <label><span data-i18n="nameLabel">Nama</span><input type="text" name="name" required placeholder="Nama kamu" data-i18n-placeholder="namePlaceholder"></label>
            <label><span data-i18n="emailLabel">Email</span><input type="email" name="email" required placeholder="email@kamu.com" data-i18n-placeholder="emailPlaceholder"></label>
          </div>
          <label><span data-i18n="messageLabel">Pesan</span><textarea name="message" rows="4" required placeholder="Ceritakan sesuatu yang bagus..." data-i18n-placeholder="messagePlaceholder"></textarea></label>
          <button type="submit" class="button button-orange" data-i18n="sendMessage">Kirim pesan <span>↗</span></button>
        </form>
      </div>
    </section>

    <!-- LEGAL -->
    <section class="legal-section section-pad">
      <div class="container legal-grid">
        <div>
          <p class="eyebrow">09 / <span data-i18n="sectionLegal">DETAIL PENTING</span></p>
          <h2 data-i18n="legalTitle">Jelas itu<br><em>baik.</em></h2>
          <p class="disclosure-note" data-i18n="disclosureNote">GoOdays memakai link afiliasi Shopee. Pembelian lewat link tersebut menghasilkan komisi untuk kami — tanpa biaya tambahan untukmu.</p>
        </div>
        <div class="legal-links">
          <a href="/legal/#privacy" data-i18n="privacy">Privacy Policy <span>↗</span></a>
          <a href="/legal/#terms" data-i18n="terms">Terms &amp; Conditions <span>↗</span></a>
          <a href="/legal/#affiliate" data-i18n="affiliate">Affiliate Disclosure <span>↗</span></a>
          <a href="/legal/#disclaimer" data-i18n="disclaimer">Disclaimer <span>↗</span></a>
        </div>
      </div>
    </section>
  </main>
</Base>
